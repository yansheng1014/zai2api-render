# Z.AI2API — Environment Configuration
# Copy this file to .env and fill in your values.
# The .env file is loaded automatically on startup.

# Z.AI JWT token (from chat.z.ai → DevTools → Local Storage → "token")
# Without this, the server uses guest mode (only glm-4.7 works).
ZAI_TOKEN=

# Multiple Z.AI JWT tokens, comma-separated. Takes precedence over ZAI_TOKEN.
# Each token becomes one pool account (round-robin scheduling).
# Accounts can also be added at runtime via POST /admin/accounts.
ZAI_TOKENS=

# Persistent gateway state (accounts, mihomo subscriptions/ports/bindings)
CONFIG_FILE=gateway.json

# Server settings (8088: 6000 is blocked by Chromium as an unsafe port)
PORT=8088
HOST=0.0.0.0

# Auth token for the API (clients must send this as Bearer token)
AUTH_TOKEN=VVVVVILK

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Path to the primary device-tokens database (from token-collector).
# Besides this file, the gateway auto-scans and merges:
#   - tokens*.sqlite next to DB_PATH (legacy naming)
#   - every *.sqlite inside TOKENS_DIR (any filename, needs a tokens table)
# Drained libraries switch over automatically; new files merge live.
DB_PATH=tokens.sqlite
# Managed token-library directory (default: ./data/tokens). Console bulk
# collection writes fresh tokens_collect_*.sqlite here.
TOKENS_DIR=

# ── Account pool ──────────────────────────────────────────────
# Max concurrent requests per account (fail-closed default: 1 = per-account
# semaphore; a second request for the same account queues or gets 429)
MAX_ACCOUNT_INFLIGHT=1
# Global concurrency cap (0 = accounts × MAX_ACCOUNT_INFLIGHT)
GLOBAL_MAX_INFLIGHT=0
# Max waiting requests when all slots are busy (0 = auto)
MAX_QUEUE_SIZE=0
# Cooldown seconds after a failure/risk-control hit before the account
# is eligible again (auto-removed from rotation meanwhile)
ACCOUNT_COOLDOWN_SECONDS=120
# Max account switches per request on retryable errors (401/429/WAF/5xx)
REQUEST_MAX_RETRY=3

# ── Account warmup worker (号池预热) ───────────────────────
# 导入/启动后的账号以滑动窗口逐个静默预热：分配专属代理端口 →
# 校验出口有效性 → 校验 ZAI_TOKEN → 预留过盾缓冲 → 就绪 (Ready) 后
# 才参与轮询。禁用后账号立即上阵（不做预热检查）。
WARMUP_ENABLED=true
# 滑动窗口节奏：相邻两个账号之间的间隔（毫秒，下限 200）
WARMUP_INTERVAL_MS=2000

# ── Daily quota ───────────────────────────────────────────────
# Max successful requests per account per day. At the limit the account
# enters "Daily Sleep" (never banned) and auto-revives at the next local
# midnight reset. 0 = unlimited.
MAX_DAILY_USAGE=50

# ── Fail-closed anti-ban isolation ────────────────────────────
# When the mihomo bridge has subscriptions: only proxy-bound accounts are
# scheduled and bound accounts NEVER fall back to the host's direct network
# (SOCKS5 failure → 502, unbound accounts are skipped). Set false to allow
# direct egress (NOT recommended for anti-ban setups).
FAIL_CLOSED=true

# ── Captcha inventory (async device-token buffer) ─────────────
# Background workers pre-solving captcha params from the token libraries
CAPTCHA_WORKERS=2
# Buffered ready-to-use captcha params
CAPTCHA_BUFFER=8
# Max wait for a buffered param before falling back to inline solving (ms)
CAPTCHA_TIMEOUT_MS=20000
# Shield egress SOCKS5 override (host:port). Empty = auto: the Mihomo
# bridge's first live listener port when online, direct otherwise.
# Keep it identical to the collector egress — Aliyun ties device tokens
# to the environment that produced them.
CAPTCHA_PROXY=
# Verbose shield diagnostics (same as the -verbose flag)
CAPTCHA_VERBOSE=false
# token-collector browser egress override (e.g. socks5://127.0.0.1:10801).
# Empty = auto-link the Mihomo bridge when it has live listeners.
COLLECTOR_PROXY=

# ── Mihomo proxy bridge (optional, one account = one exit IP) ─
# Path to the mihomo (clash.meta) binary. Search order:
# admin settings binary_path > MIHOMO_PATH > gateway exe dir / bin / data.
# On Windows place mihomo.exe next to zai2api.exe.
MIHOMO_PATH=
# Working directory for runtime.yaml / logs (default: data/mihomo)
MIHOMO_DIR=
# High-frequency watcher beat (seconds): full delay test of ALL nodes +
# failover/auto-assign reconciliation each tick (recommended 15–30)
MIHOMO_SWEEP_INTERVAL=15
# Delay (seconds) after mihomo boots before the one-shot full test +
# auto-assign sweep fires
MIHOMO_BOOT_SWEEP_DELAY=5
# Per-node delay test timeout (ms)
MIHOMO_HEALTH_TIMEOUT=5000
# Nodes slower than this ceiling count as dead and trigger failover (ms)
MIHOMO_MAX_LATENCY_MS=3000
# Consecutive failures before a node is considered dead (failover trigger)
MIHOMO_FAIL_THRESHOLD=2
# Cooldown (minutes) forced on an account after failover swaps its exit IP
# — prevents rapid IP hopping from tripping upstream risk control
MIHOMO_IP_SWITCH_COOLDOWN_MINUTES=15
# URL used for node delay tests
MIHOMO_TEST_URL=https://www.gstatic.com/generate_204

# The bridge is enabled by default when gateway.json has no mihomo section
# yet; it stays idle until subscriptions are added (POST /admin/mihomo/subscriptions).
# Toggle it later via POST /admin/mihomo/settings {"enabled":true|false}.
